rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'benitezsamuel930@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function seasonRef() {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/season_config/main;
    }

    function currentSeason() {
      return get(seasonRef()).data.seasonNumber;
    }

    function accountRef(uid) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/cuentas/$(uid);
    }

    function playerProfile() {
      return get(accountRef(request.auth.uid)).data;
    }

    function playerName() {
      return playerProfile().nombre;
    }

    function isPlayer() {
      return signedIn()
        && !admin()
        && exists(accountRef(request.auth.uid))
        && playerProfile().role == 'JUGADOR'
        && playerProfile().estado == 'APROBADO'
        && request.auth.token.email_verified == true;
    }

    function playerExists(name) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/jugadores/$(name));
    }

    function allMatchPlayersExist(data) {
      return data.ganadores.size() >= 1
        && data.perdedores.size() >= 1
        && playerExists(data.ganadores[0])
        && playerExists(data.perdedores[0])
        && (
          data.tipo == '1v1'
          || (
            data.ganadores.size() == 2 && data.perdedores.size() == 2
            && playerExists(data.ganadores[1])
            && playerExists(data.perdedores[1])
          )
          || (
            data.ganadores.size() == 3 && data.perdedores.size() == 3
            && playerExists(data.ganadores[1]) && playerExists(data.ganadores[2])
            && playerExists(data.perdedores[1]) && playerExists(data.perdedores[2])
          )
        );
    }

    function validMatch(data) {
      return data.schemaVersion == 2
        && data.id is string
        && data.seasonNumber == currentSeason()
        && data.tipo in ['1v1', '2v2', '3v3']
        && data.ganadores is list
        && data.perdedores is list
        && data.ptsGanador is number
        && data.ptsPerdedor is number
        && data.ventaja is number
        && data.puntosGanadorPorJugador is number
        && data.ptsGanador >= 0 && data.ptsGanador <= 30
        && data.ptsPerdedor >= 0 && data.ptsPerdedor <= 30
        && data.ptsGanador > data.ptsPerdedor
        && data.ventaja == data.ptsGanador - data.ptsPerdedor
        && (
          (data.tipo == '1v1' && data.ganadores.size() == 1 && data.perdedores.size() == 1 && data.puntosGanadorPorJugador == 1)
          ||
          (data.tipo == '2v2' && data.ganadores.size() == 2 && data.perdedores.size() == 2 && data.puntosGanadorPorJugador == 2)
          ||
          (data.tipo == '3v3' && data.ganadores.size() == 3 && data.perdedores.size() == 3 && data.puntosGanadorPorJugador == 2)
        )
        && allMatchPlayersExist(data)
        && ((data.tipo == '1v1' && data.ganadores[0] != data.perdedores[0])
          || (data.tipo == '2v2' && data.ganadores[0] != data.ganadores[1] && data.perdedores[0] != data.perdedores[1]
              && data.ganadores[0] != data.perdedores[0] && data.ganadores[0] != data.perdedores[1] && data.ganadores[1] != data.perdedores[0] && data.ganadores[1] != data.perdedores[1])
          || (data.tipo == '3v3' && data.ganadores[0] != data.ganadores[1] && data.ganadores[0] != data.ganadores[2] && data.ganadores[1] != data.ganadores[2]
              && data.perdedores[0] != data.perdedores[1] && data.perdedores[0] != data.perdedores[2] && data.perdedores[1] != data.perdedores[2]
              && data.ganadores[0] != data.perdedores[0] && data.ganadores[0] != data.perdedores[1] && data.ganadores[0] != data.perdedores[2]
              && data.ganadores[1] != data.perdedores[0] && data.ganadores[1] != data.perdedores[1] && data.ganadores[1] != data.perdedores[2]
              && data.ganadores[2] != data.perdedores[0] && data.ganadores[2] != data.perdedores[1] && data.ganadores[2] != data.perdedores[2]));
    }

    function creatorIdentityIsValid(data) {
      return data.creatorUid == request.auth.uid
        && data.usuarioCarga == request.auth.token.email
        && data.jugadorCarga == playerName()
        && (data.ganadores.hasAny([playerName()]) || data.perdedores.hasAny([playerName()]));
    }

    match /artifacts/{appId}/public/data/cuentas/{uid} {
      allow get: if admin() || (signedIn() && uid == request.auth.uid);
      allow list: if admin();
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'JUGADOR'
        && request.resource.data.estado == 'PENDIENTE'
        && request.resource.data.keys().hasOnly(['uid','email','nombre','role','estado','emailVerified','createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if admin()
        && (
          request.resource.data.estado != 'APROBADO'
          || resource.data.estado == 'APROBADO'
          || !exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/jugadores/$(request.resource.data.nombre))
        );
      allow delete: if admin();
    }

    match /artifacts/{appId}/public/data/jugadores/{playerId} {
      allow read: if signedIn();
      // Un jugador puede crear su propio documento de perfil únicamente para guardar su avatar.
      allow create: if admin()
        || (
          isPlayer()
          && playerId == playerName()
          && request.resource.data.nombre == playerName()
          && request.resource.data.avatarData is string
          && request.resource.data.avatarData.size() <= 20000
          && request.resource.data.avatarUpdatedAt == request.time
        );
      // El jugador solo puede modificar su propio avatar y, una vez cambiado, debe esperar 21 días.
      // Los perfiles antiguos que guardaban avatarUpdatedAt como número pueden migrarse una sola vez.
      allow update: if (
          admin()
          || (isPlayer() && playerId == playerName())
        )
        && request.resource.data.nombre == resource.data.nombre
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarData','avatarUpdatedAt'])
        && request.resource.data.avatarData is string
        && request.resource.data.avatarData.size() <= 20000
        && request.resource.data.avatarUpdatedAt == request.time
        && (
          !resource.data.keys().hasAny(['avatarUpdatedAt'])
          || (resource.data.avatarUpdatedAt is timestamp && resource.data.avatarUpdatedAt + duration.value(21, 'd') <= request.time)
          || (resource.data.avatarUpdatedAt is number && timestamp.value(resource.data.avatarUpdatedAt) + duration.value(21, 'd') <= request.time)
        );
      allow delete: if admin();
    }

    match /artifacts/{appId}/public/data/partidas/{matchId} {
      allow read: if admin() || resource.data.estado == 'APROBADA' || (signedIn() && resource.data.creatorUid == request.auth.uid);

      allow create: if admin()
        && validMatch(request.resource.data)
        && request.resource.data.id == matchId
        && request.resource.data.estado == 'APROBADA'
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.usuarioCarga == request.auth.token.email
        && request.resource.data.aprobadoPor == request.auth.uid
        && request.resource.data.aprobadoAt == request.time;

      allow create: if isPlayer()
        && validMatch(request.resource.data)
        && request.resource.data.id == matchId
        && request.resource.data.estado == 'PENDIENTE'
        && creatorIdentityIsValid(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if (
          admin()
          && validMatch(request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.creatorUid == resource.data.creatorUid
          && request.resource.data.seasonNumber == resource.data.seasonNumber
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado','aprobadoAt','aprobadoPor','rechazadoAt','rechazadoPor','anuladoAt','anuladoPor','ultimaRevisionAt','ultimaRevisionPor','syncStatus','offlineQueued'
          ])
          && (
            (resource.data.estado == 'PENDIENTE' && request.resource.data.estado in ['APROBADA','RECHAZADA'])
            || (resource.data.estado == 'APROBADA' && request.resource.data.estado == 'ANULADA')
          )
        ) || (
          admin()
          && request.resource.data.id == resource.data.id
          && request.resource.data.creatorUid == resource.data.creatorUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ganador','perdedor','ganadores','perdedores','jugadorCarga'])
        );

      allow delete: if admin();
    }

    match /artifacts/{appId}/public/data/season_config/{docId} {
      allow read: if signedIn();
      allow write: if admin();
    }

    match /artifacts/{appId}/public/data/season_history/{docId} {
      allow read: if signedIn();
      allow write, delete: if admin();
    }

    match /artifacts/{appId}/public/data/hallOfFameTitles/{docId} {
      allow read: if signedIn();
      allow write, delete: if admin();
    }

    match /artifacts/{appId}/public/data/h2h_summary/{docId} {
      allow read: if admin();
      allow write, delete: if admin();
    }

    match /artifacts/{appId}/public/data/auditLogs/{logId} {
      allow read: if admin();
      allow create: if admin()
        || (
          signedIn()
          && request.resource.data.tipo == 'ACCESS'
          && request.resource.data.accion == 'LOGIN'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'JUGADOR'
        )
        || (
          isPlayer()
          && request.resource.data.tipo == 'PLAYER_PROFILE'
          && request.resource.data.accion == 'ACTUALIZÓ AVATAR'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'JUGADOR'
          && request.resource.data.jugadoresInvolucrados is list
          && request.resource.data.jugadoresInvolucrados.size() == 1
          && request.resource.data.jugadoresInvolucrados[0] == playerName()
        )
        || (
          isPlayer()
          && request.resource.data.tipo == 'MATCH_SUBMISSION'
          && request.resource.data.accion in ['CARGÓ PARTIDA','CARGÓ PARTIDA OFFLINE / SINCRONIZADA']
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'JUGADOR'
          && request.resource.data.matchId is string
          && request.resource.data.jugadoresInvolucrados is list
          && request.resource.data.ganadores is list
          && request.resource.data.perdedores is list
          && request.resource.data.ptsGanador is number
          && request.resource.data.ptsPerdedor is number
          && exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/partidas/$(request.resource.data.matchId))
          && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/partidas/$(request.resource.data.matchId)).data.creatorUid == request.auth.uid
          && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/partidas/$(request.resource.data.matchId)).data.jugadorCarga == playerName()
          && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/partidas/$(request.resource.data.matchId)).data.ganadores == request.resource.data.ganadores
          && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/partidas/$(request.resource.data.matchId)).data.perdedores == request.resource.data.perdedores
          && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/partidas/$(request.resource.data.matchId)).data.ptsGanador == request.resource.data.ptsGanador
          && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/partidas/$(request.resource.data.matchId)).data.ptsPerdedor == request.resource.data.ptsPerdedor
        );
      allow update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
